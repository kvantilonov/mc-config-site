import os
from flask import Flask, request, send_from_directory, render_template_string

app = Flask(__name__)
UPLOAD_FOLDER = 'configs'
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

@app.route('/')
@app.route('/configs')
def list_configs():
    files = os.listdir(UPLOAD_FOLDER)
    files = [f for f in files if f.endswith('.cfg')]
    return render_template_string('''
        <h2>Список конфигов:</h2>
        <ul>
            {% for file in files %}
                <li><a href="{{ url_for('get_config', filename=file) }}">{{ file }}</a></li>
            {% endfor %}
        </ul>
    ''', files=files)

@app.route('/upload', methods=['POST'])
def upload_config():
    if 'file' not in request.files:
        return 'Нет файла', 400
    file = request.files['file']
    if file.filename == '':
        return 'Пустое имя файла', 400
    save_path = os.path.join(UPLOAD_FOLDER, file.filename)
    file.save(save_path)
    return f'Файл загружен: /configs/{file.filename}', 200

@app.route('/configs/<filename>')
def get_config(filename):
    return send_from_directory(UPLOAD_FOLDER, filename)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
